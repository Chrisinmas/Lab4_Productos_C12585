@model List<Lab4_Productos_C12585.Models.Producto>

@{
    ViewData["Title"] = "Directorio de Productos";
}

<h2>Directorio de Productos</h2>

<a asp-action="Crear" class="btn btn-primary mb-3">Agregar Producto</a>

@if (!Model.Any())
{
    <p class="text-muted">No hay productos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Categoría</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.Id</td>
                    <td>@producto.Nombre</td>
                    <td>@producto.Precio.ToString("C")</td>
                    <td>@producto.Categoria</td>
                    <td>
                        <a asp-action="Detalles" asp-route-id="@producto.Id" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@producto.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}